#!/usr/bin/env python3
"""Pick a project directory or a recent session, then start Claude Code there.
When Claude exits, the picker comes back. See README.md for the keys, and
src/claude_launcher/launcher.py for how it runs.

  claude-launcher [claude options]   pick, then run claude with those options
  claude-launcher --resume <id>      skip the picker: resume that session in its directory
"""

import os
import sys

# Before the package, whose syntax an older Python can't read; so nothing
# newer than Python 2.7 above here either.
if sys.version_info < (3, 10):  # noqa: UP036
    sys.stderr.write(
        "claude-launcher needs Python 3.10 or newer (this is %d.%d: %s)\n"  # noqa: UP031
        % (sys.version_info[0], sys.version_info[1], sys.executable)
    )
    sys.exit(1)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from claude_launcher.launcher import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
